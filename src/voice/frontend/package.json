{
  "name": "@wippy-swiss/voice",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "Voice Orb",
  "description": "Auto-registered voice widget with STT and TTS. Tag: <wippy-voice-orb>.",
  "browser": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@huggingface/transformers": "^4.3.2",
    "@ricky0123/vad-web": "^0.0.31",
    "@wippy-fe/shared": "0.0.70",
    "@wippy-fe/theme": "0.0.70",
    "@wippy-fe/webcomponent-core": "0.0.70",
    "@wippy-fe/webcomponent-vue": "0.0.70",
    "onnxruntime-web": "^1.31.1",
    "primevue": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.156",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@wippy-fe/proxy": "0.0.70",
    "@wippy-fe/vite-plugin": "0.0.70",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "markdown-it": "^15.0.3",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^7.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "0.0.70",
    "vue": "^3.5.0"
  },
  "wippy": {
    "tagName": "wippy-voice-orb",
    "type": "widget",
    "description": "Animated voice input/output widget. Self-contained — no props required. Connects to the host app via the Wippy proxy to handle voice sessions, speech-to-text (Deepgram / Whisper), and text-to-speech (Deepgram / ElevenLabs). Requires the wippy-swiss/voice backend (ask, tts-token, pages endpoints) to be wired to an authenticated API router.\n\nExample:\n\n<wippy-voice-orb />",
    "props": {
      "type": "object",
      "properties": {
        "attention-context-enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Attention context for voice messages"
        },
        "agent-name": {
          "type": "string",
          "description": "Safe registry ID of the voice agent; never a token"
        }
      }
    },
    "scripts": {
      "build": "build",
      "debug": "build:debug",
      "test": "lint"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:debug": "vite build --mode development",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  }
}
